---
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import { t, SOCIALS, type Lang } from '../i18n';
import medium from '../data/medium.json';
import note from '../data/note.json';
import gh from '../data/github.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const ghv: Record<string, number> = { repos: gh.publicRepos, thesis: gh.thesisRepos, hack: gh.hackathonRepos };
const feeds = [
  { name: c.medium, items: medium.slice(0, 3), href: 'https://medium.com/furuhashilab' },
  { name: c.note, items: note.slice(0, 3), href: 'https://note.com/mapconcierge' },
];
const built = new Date().toISOString().slice(0, 10);
const featured = (gh.featured ?? []).filter((r: { name: string }) => !/^(README|\.github)$/i.test(r.name)).slice(0, 5);
---
<Base lang={lang}>
  <header class="top">
    <div class="wrap">
      <a class="brand" href={lang === 'ja' ? '/' : '/en/'}><span class="logo"><Logo /></span><span>{lang === 'ja' ? '古橋研究室' : 'Furuhashi Lab'}</span></a>
      <nav class="links" aria-label="Main">{c.nav.map(([h, l]) => <a href={h}>{l}</a>)}</nav>
      <a class="lang" href={c.switchHref} hreflang={lang === 'ja' ? 'en' : 'ja'}>{c.switchLabel}</a>
    </div>
  </header>

  <main>
    <div class="hero">
      <div class="wrap grid">
        <div>
          <span class="eyebrow">{c.heroKicker}</span>
          <h1>{lang === 'ja' ? <mark>一億総伊能化</mark> : <mark>Billions Inō-zation</mark>}</h1>
          <p class="en">{lang === 'ja' ? 'Billions Inō-zation' : '一億総伊能化'}</p>
          <p class="sub">{c.heroSub}</p>
          <p class="lead">{c.heroLead}</p>
          <div class="btns">
            <a class="btn" href="#students">{c.ctaStudents}</a>
            <a class="btn alt" href="#companies">{c.ctaCompanies}</a>
          </div>
        </div>
        <div class="mapbox" role="img" aria-label="Globe map">
          <div id="map" data-places={JSON.stringify(c.places)}></div>
          <div class="mapcap" id="mapcap" aria-live="polite">{c.places[0].name}</div>
        </div>
      </div>
    </div>

    <section id="inozation" style="padding-top:24px">
      <div class="inoz">
        <div class="wrap inoz-grid">
          <div class="inoz-text">
            <span class="eyebrow">Billions Inō-zation</span>
            <h2>{c.inoTitle}</h2>
            <p>{c.inoBody}</p>
            <p class="aim">{c.inoAim}</p>
            <small>{c.inoSrc}<a href="https://internet.watch.impress.co.jp/docs/column/chizu3/1621861.html" rel="noopener">{c.inoSrcName}</a></small>
          </div>
          <figure class="prof">
            <img src="/images/furuhashi-taichi.jpg" width="1200" height="1099" alt={c.profAlt} loading="lazy" decoding="async" />
            <figcaption><b>{c.profName}</b><span>{c.profRole}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="what"><div class="wrap">
      <h2>{c.whatTitle}</h2>
      <div class="cards">{c.what.map((w) => <div class="card"><span class={`dot ${w.c}`}></span><h3>{w.t}</h3><p>{w.d}</p></div>)}</div>
      <div class="nums">{c.numbers.map((n) => <div class="num"><b>{n.n}</b>{n.l}</div>)}</div>
      <p class="muted"><small>{c.numbersNote}</small></p>
    </div></section>

    <section id="students" class="split"><div class="wrap">
      <span class="eyebrow">For students</span>
      <h2>{c.stTitle}</h2>
      <p class="muted">{c.stLead}</p>
      <div class="cards">{c.st.map((s) => <div class="card"><h3>{s.t}</h3><p>{s.d}</p></div>)}</div>
      <p>{c.stAward}</p>
      <div class="btns"><a class="btn" href="https://medium.com/furuhashilab" rel="noopener">{c.stBtn}</a><a class="btn alt" href="https://github.com/furuhashilab" rel="noopener">{c.stBtn2}</a></div>
    </div></section>

    <section id="companies" class="split co"><div class="wrap">
      <span class="eyebrow">For partners</span>
      <h2>{c.coTitle}</h2>
      <p class="muted">{c.coLead}</p>
      <div class="cards">{c.co.map((s) => <div class="card"><h3>{s.t}</h3><p>{s.d}</p></div>)}</div>
      <div class="btns" style="margin-top:20px"><a class="btn" href="https://www.facebook.com/furuhashilab/" rel="noopener">{c.coBtn}</a></div>
      <p class="muted"><small>{c.coNote}</small></p>
    </div></section>

    <section id="now"><div class="wrap">
      <h2>{c.nowTitle}</h2>
      <p class="muted">{c.nowSub}</p>
      {feeds.map((f) => f.items.length > 0 && (
        <div>
          <h3 style="margin-top:24px">{f.name}</h3>
          <div class="feed">{f.items.map((p) => (
            <a class="post" href={p.url} rel="noopener">
              {p.image ? <img src={p.image} alt="" loading="lazy" /> : <img alt="" />}
              <div class="b"><span>{p.date}</span><strong>{p.title}</strong></div>
            </a>))}</div>
          <a class="more" href={f.href} rel="noopener">{c.allPosts}</a>
        </div>))}

      <h2 style="margin-top:56px">{c.ghTitle}</h2>
      <p class="muted">{c.ghLead}</p>
      <div class="stats">{c.ghStats.map(([k, l]) => <div class="stat"><b>{ghv[k]}</b>{l}</div>)}</div>
      {featured.length > 0 && <>
        <h3>{c.ghFeatured}</h3>
        <ul class="repos">{featured.map((r: any) => <li><a href={r.url} rel="noopener"><code>{r.name}</code> <span class="muted">— {r.description}</span></a></li>)}</ul>
      </>}
      <a class="more" href="https://github.com/furuhashilab" rel="noopener">{c.ghMore}</a>
    </div></section>

    <section id="follow" class="split"><div class="wrap">
      <h2>{c.followTitle}</h2>
      <p class="muted">{c.followSub}</p>
      <div class="socials">{SOCIALS.map((s) => (
        <a class={`soc ${s.color}`} href={s.url} rel="noopener me">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d={s.icon} /></svg>
          <span>{s.label}</span>
        </a>))}</div>
    </div></section>

    <section id="access"><div class="wrap">
      <h2>{c.accessTitle}</h2>
      <p>{c.address}<br /><span class="muted">{c.accessNote}</span></p>
    </div></section>
  </main>

  <footer><div class="wrap">
    <p>{c.license} {c.profCredit}.</p>
    <p><a href={c.archiveHref}>{c.archive}</a> · <a href="https://github.com/furuhashilab/www_furuhashiab_com">GitHub</a></p>
    <p>{c.thanks} · {c.updated}: {built}</p>
  </div></footer>

  <script>
    import * as maplibregl from 'maplibre-gl';
    import 'maplibre-gl/dist/maplibre-gl.css';

    // Worker files are copied to /vendor/maplibre/ by scripts/copy-maplibre-worker.mjs
    maplibregl.setWorkerUrl('/vendor/maplibre/maplibre-gl-worker.mjs');

    const el = document.getElementById('map');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (el) {
      type Place = { name: string; center: [number, number]; zoom: number; pitch: number };
      // [lng, lat] WGS84, see src/i18n.ts: 0 Furuhashi Lab (Sagamihara), 1 Tsukumana Lab (Aoyama), 2 ANNEX (Yokoze)
      const places: Place[] = JSON.parse(el.dataset.places || '[]');
      const cap = document.getElementById('mapcap');
      const map = new maplibregl.Map({
        container: el,
        style: 'https://tiles.openfreemap.org/styles/liberty',
        center: places[0].center, zoom: 1.6, pitch: 0, attributionControl: { compact: true },
        interactive: true,
      });
      (window as any).__map = map; // handy for debugging in DevTools
      map.scrollZoom.disable();

      // Tour: orbit around a place for ORBIT_MS, fly to the next place, orbit there, ... and loop.
      // Orbit rotates only the bearing (center stays fixed). It pauses while the user touches the map,
      // when offscreen, or when the tab is hidden. Disabled entirely for prefers-reduced-motion.
      const DEG_PER_SEC = 6;   // one full turn in 60 s
      const ORBIT_MS = 36000;  // orbit time per place (only counts while actually orbiting)
      const TRAVEL_MS = 9000;
      let mode: 'idle' | 'travel' | 'orbit' = 'idle';
      let idx = 0, elapsed = 0, last = 0, token = 0, userHold = false, visible = true, resumeTimer = 0;
      const farFrom = (p: Place) => Math.hypot(p.center[0] - map.getCenter().lng, p.center[1] - map.getCenter().lat) > 0.003;

      const travelTo = (i: number, duration: number, bearing?: number) => {
        idx = i; mode = 'travel'; elapsed = 0; last = 0;
        const p = places[i], my = ++token;
        if (cap) cap.textContent = p.name;
        map.once('moveend', () => {
          if (my !== token) return;                     // superseded by a newer flight
          if (farFrom(p)) { mode = 'idle'; return; }    // interrupted by the user: retried on release
          mode = 'orbit'; elapsed = 0; last = 0;
        });
        map.flyTo({ center: p.center, zoom: p.zoom, pitch: p.pitch, ...(bearing === undefined ? {} : { bearing }), duration, curve: 1.6, essential: false });
      };

      const tick = (now: number) => {
        const active = () => mode === 'orbit' && !userHold && visible && !document.hidden;
        if (active() && last) {
          const dt = now - last;
          map.setBearing((map.getBearing() + (dt / 1000) * DEG_PER_SEC) % 360);
          elapsed += dt;
          if (elapsed >= ORBIT_MS) travelTo((idx + 1) % places.length, TRAVEL_MS);
        }
        last = active() ? now : 0;
        requestAnimationFrame(tick);
      };

      const hold = () => { userHold = true; clearTimeout(resumeTimer); };
      const release = () => {
        clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          userHold = false; last = 0;
          if (mode !== 'travel' && farFrom(places[idx])) travelTo(idx, 3000); // user dragged away: come back
        }, 4000);
      };
      for (const ev of ['pointerdown', 'touchstart', 'wheel']) el.addEventListener(ev, hold, { passive: true });
      for (const ev of ['pointerup', 'pointercancel', 'touchend']) el.addEventListener(ev, release, { passive: true });
      el.addEventListener('wheel', release, { passive: true });
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(el);

      map.on('style.load', () => {
        map.setProjection({ type: 'globe' });
        // Elevation: Mapterhorn terrarium PNG/WebP DEM
        map.addSource('mapterhorn', { type: 'raster-dem', tiles: ['https://tiles.mapterhorn.com/{z}/{x}/{y}.webp'], tileSize: 512, encoding: 'terrarium', maxzoom: 12, attribution: '<a href="https://mapterhorn.com/attribution">© Mapterhorn</a>' });
        map.setTerrain({ source: 'mapterhorn', exaggeration: 1.2 });
        map.addSource('lab', { type: 'geojson', data: { type: 'FeatureCollection', features: places.map((p) => ({ type: 'Feature', properties: { name: p.name }, geometry: { type: 'Point', coordinates: p.center } })) } });
        map.addLayer({ id: 'lab-halo', type: 'circle', source: 'lab', paint: { 'circle-radius': 16, 'circle-color': '#ffd23f', 'circle-opacity': 0.5 } });
        map.addLayer({ id: 'lab-dot', type: 'circle', source: 'lab', paint: { 'circle-radius': 7, 'circle-color': '#ff6b5e', 'circle-stroke-color': '#14213d', 'circle-stroke-width': 3 } });
        // OpenFreeMap "liberty" has 3D buildings (building-3d, visible from z14)
        if (reduce) {
          map.jumpTo({ center: places[0].center, zoom: places[0].zoom, pitch: places[0].pitch, bearing: -20 });
        } else {
          setTimeout(() => travelTo(0, 7000, -20), 800);
          requestAnimationFrame(tick);
        }
      });
    }
  </script>
</Base>
